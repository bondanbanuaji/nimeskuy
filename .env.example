# ==============================================================
# NimeSkuy — Environment Variables
# Salin file ini menjadi `.env.local` untuk development, atau
# set nilai di Vercel Dashboard (Settings → Environment Variables).
# JANGAN commit file `.env*` yang berisi nilai asli ke repository.
# ==============================================================

# --- Site URL (penting untuk SEO) ------------------------------
# URL absolut production tanpa trailing slash.
# Digunakan untuk: canonical URL, sitemap.xml, robots.txt, Open Graph.
# Jika tidak diset, sistem akan fallback ke VERCEL_URL (otomatis di Vercel),
# lalu ke http://localhost:3000 (development).
# Contoh: https://nimeskuy.vercel.app atau https://nimeskuy.com
NEXT_PUBLIC_SITE_URL=

# (Legacy, opsional — NEXT_PUBLIC_SITE_URL lebih diprioritaskan)
NEXT_PUBLIC_APP_URL=

# --- Sanka Anime API -------------------------------------------
# Base URL Sanka Anime REST API (agregator data Otakudesu dkk).
# Default: https://www.sankavollerei.web.id
# Hanya perlu diubah jika API dipindah / self-hosted.
SANKA_API_URL=

# --- Opsional: Verifikasi Google Search Console ----------------
# Isi dengan kode meta tag verifikasi dari Google Search Console
# (format: string dari searchconsole.google.com, tanpa "google-site-verification=")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
